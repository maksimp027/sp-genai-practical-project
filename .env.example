# Optional API Keys for Generative LLM synthesis
# The system also works in local mode with Ollama or local extractive synthesis

# Google Gemini API Key (Recommended for multimodal vision answers)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Alternative backend)
OPENAI_API_KEY=

# Ollama local instance URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
